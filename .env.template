# region model_provider
# 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ
SILICONFLOW_API_KEY=
# 可选: tavily | deepseek | doubao；留空按已配置凭据选择
WEB_SEARCH_PROVIDER=
# 豆包联网搜索 API Key
DOUBAO_SEARCH_API_KEY=
# Tavily Search / Fetch API Key https://app.tavily.com/
TAVILY_API_KEY=
# DeepSeek Search / Fetch API Key；也可在设置 → 网络搜索中填写
DEEPSEEK_API_KEY=

# 身份安全配置：JWT 与 API Key 派生密钥必须分别生成并持久保存，初始化脚本会补齐留空值
YUXI_ENV=development
JWT_SECRET_KEY=
API_KEY_DERIVATION_SECRET=
YUXI_INSTANCE_ID=

# 默认启用知识库；关闭本地知识库容器使用 docker-compose.no-knowledge.yml，详见部署文档。
YUXI_KNOWLEDGE_ENABLED=true

# 通用持久凭据加密：API 与 worker 使用同一 Fernet 密钥；勿复用 JWT 签名密钥。
# 生成：python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
YUXI_ENCRYPTION_KEY=
# 浏览器可达的站点来源，如 https://yuxi.example.com；回调路径由代码固定。
YUXI_PUBLIC_URL=

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
YUXI_CORS_ORIGINS=

# 并行运行多个 worktree 时配置；单环境无需设置。
# 完整示例见 docs/develop-guides/parallel-worktree-environments.md
# COMPOSE_PROJECT_NAME=yuxi-dev-a
# YUXI_STATE_DIR=../.yuxi/slots/dev-a

# # 其余可选配置
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# ZHIPUAI_API_KEY=
# DASHSCOPE_API_KEY=
# ARK_API_KEY=
# MINIMAX_API_KEY=  # MiniMax 大模型 https://platform.minimaxi.com/
# TOGETHER_API_KEY=
# # endregion model_provider

# Production credentials (required by docker-compose.prod.yml)
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Public images use the frontend same-origin proxy by default.
# MINIO_PUBLIC_URL=/minio

# # region neo4j
# NEO4J_URI=
# NEO4J_USERNAME=
NEO4J_PASSWORD=
# # endregion neo4j

# # Services
# # ARQ worker 单任务最长执行时间（秒），默认 3600，长耗时任务需调大
# YUXI_JOB_TIMEOUT_SECONDS=3600
# WORKER_HEALTH_INTERVAL_SECONDS=5  # 必须大于 0 且不超过 10；过长会破坏 worker 故障探测
# READINESS_PROBE_TIMEOUT_SECONDS=2
# READINESS_CACHE_TTL_SECONDS=1

# # URL Whitelist (comma-separated domains/IPs, empty to disable URL parsing)
# YUXI_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# # MinerU
# MINERU_API_KEY=

# # PaddleOCR API
# PADDLEOCR_API_TOKEN=
# PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# 沙盒后端：container（默认，Docker/Podman 轻量执行）或 cube（Linux/KVM 强隔离）
SANDBOX_BACKEND=container

# Cube 用户环境：单节点 Linux/KVM，与 Yuxi 共享同一份文件目录
CUBE_API_URL=
CUBE_API_KEY=
CUBE_PROXY_NODE_IP=
CUBE_PROXY_PORT_HTTP=80
CUBE_TEMPLATE_ID=yuxi-user
CUBE_NODE_USER_DATA_DIR=/data/shared/yuxi/threads
CUBE_NODE_SKILL_PROJECTION_DIR=/data/shared/yuxi/skill-projections
SANDBOX_IDLE_SECONDS=300
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144

# Container 沙盒：仅单租户/可信代码使用，启动时加 --profile container。
# SANDBOX_RUNNER_TOKEN=                 # 生产必填，初始化脚本会生成
# SANDBOX_RUNNER_URL=http://sandbox-runner:8090
# SANDBOX_CONTAINER_IMAGE=yuxi-sandbox:0.8.0.beta6
# SANDBOX_CONTAINER_IMAGE_DIGEST=       # 生产必填，sha256:...
# SANDBOX_CONTAINER_NETWORK=none        # none 或 bridge；bridge 会削弱网络隔离
# SANDBOX_CONTAINER_MEMORY_BYTES=1073741824
# SANDBOX_CONTAINER_CPUS=1
# SANDBOX_CONTAINER_PIDS_LIMIT=256
# SANDBOX_CONTAINER_HOME_BYTES=268435456
# SANDBOX_CONTAINER_TMP_BYTES=268435456
# SANDBOX_CONTAINER_MAX_CONTAINERS=32
# SANDBOX_CONTAINER_MAX_EXECS=8
# SANDBOX_CONTAINER_MAX_LIFETIME_SECONDS=7200
# SANDBOX_CONTAINER_UID=1000
# SANDBOX_CONTAINER_GID=1000
# runner 容器内的数据/Skill 挂载点；直接运行 runner 时改成宿主实际路径
# SANDBOX_CONTAINER_DATA_MOUNT=/sandbox-data
# SANDBOX_CONTAINER_SKILL_MOUNT=/sandbox-skill-projections
# 仅 runner 在容器外运行时需要显式给出 Docker daemon 视角的宿主路径
# SANDBOX_CONTAINER_HOST_DATA_DIR=
# SANDBOX_CONTAINER_HOST_SKILL_DIR=

# Agent 并发容量（默认按单 worker、100 个同时运行的 AgentRun 配置）
# ARQ_MAX_JOBS=140
# Redis 值是对应进程内每个客户端池的连接上限；进程可按需创建多个池，且不会预先建满。
# API_REDIS_MAX_CONNECTIONS=256
# WORKER_REDIS_MAX_CONNECTIONS=256
# API_POSTGRES_POOL_SIZE=120
# API_POSTGRES_MAX_OVERFLOW=40
# API_POSTGRES_POOL_TIMEOUT_SECONDS=30
# API_LANGGRAPH_POSTGRES_POOL_SIZE=10
# API_LANGGRAPH_POSTGRES_POOL_TIMEOUT_SECONDS=30
# WORKER_POSTGRES_POOL_SIZE=120
# WORKER_POSTGRES_MAX_OVERFLOW=40
# WORKER_POSTGRES_POOL_TIMEOUT_SECONDS=30
# WORKER_LANGGRAPH_POSTGRES_POOL_SIZE=120
# WORKER_LANGGRAPH_POSTGRES_POOL_TIMEOUT_SECONDS=30
# POSTGRES_MAX_CONNECTIONS=600

# Milvus 知识库与图向量使用同一数据库，API / worker 重建后生效
MILVUS_DB=yuxi

# Milvus 容器 CPU 上界（重建容器后生效；让镜像内置 maxprocs 按 cgroup quota 收敛 GOMAXPROCS）
# 内存随知识库数据量线性增长，故意不设上限：硬上界只会在数据合法增长时
# 把容器推入 OOM→重启→重加载→再 OOM 的循环，监控告警比 kill 更合适
# YUXI_MILVUS_CPUS=2

# 企业 OIDC 默认关闭；完整配置见 docs/advanced/third-party-auth.md
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=企业统一登录
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# 仅隔离实验可列出准确 HTTP 来源，以逗号分隔；生产留空。
MCP_OAUTH_LAB_HTTP_ORIGINS=
