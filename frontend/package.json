{
  "name": "yuxi-frontend",
  "version": "0.8.0.beta6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "vite serve --host",
    "server:prod": "vite serve --host --port 8080",
    "build": "pnpm run typecheck && vite build",
    "test:unit": "node --test --test-concurrency=2 \"test/**/*.test.js\" \"test/**/*.spec.js\"",
    "preview": "vite preview",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write --experimental-cli src/",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@lucide/vue": "^1.34.0",
    "@opencode-ai/models": "0.0.55",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@vueuse/core": "^14.4.0",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.1",
    "katex": "^0.18.4",
    "less": "^4.9.0",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "shiki": "^4.4.3",
    "vue": "^3.5.42",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.4",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "pnpm@11.24.0"
}
